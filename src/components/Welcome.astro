---
// The starter's homepage. Replace it with your own; analytics keeps working because the integration in
// astro.config.mjs adds the tracker to every built page.
// Optional: a public measuremy.site dashboard for this site (Setup tab → Public dashboard).
const statsUrl = import.meta.env.PUBLIC_MEASUREMYSITE_STATS_URL;
---

<main>
	<header>
		<p class="eyebrow">Astro starter</p>
		<h1>Astro with analytics your coding agent can read</h1>
		<p class="lede">
			Astro's basics template with cookieless <a href="https://measuremy.site">measuremy.site</a> analytics already wired
			in, plus <code>AGENTS.md</code>, <code>CLAUDE.md</code> and <code>.mcp.json</code> so Claude Code, Cursor or Codex can
			answer questions about your traffic.
		</p>
		<p class="status" id="status">
			<span class="dot" aria-hidden="true"></span>
			<span id="status-text">Analytics is off: set PUBLIC_MEASUREMYSITE_KEY and build (astro dev is never tracked)</span>
		</p>
		{statsUrl && (
			<p><a class="button" href={statsUrl}>See this site's live traffic</a></p>
		)}
	</header>

	<section aria-labelledby="setup">
		<h2 id="setup">Set it up</h2>
		<ol class="steps">
			<li>
				<strong>Get a site key.</strong> Sign up at <a href="https://measuremy.site/login">measuremy.site</a>, add your
				domain and copy the <code>pk_...</code> key from the Setup tab. It's public and safe to commit.
			</li>
			<li>
				<strong>Set it.</strong> Put <code>PUBLIC_MEASUREMYSITE_KEY=pk_...</code> in <code>.env</code> or in your host's
				environment variables.
			</li>
			<li>
				<strong>Deploy.</strong> Every built page is tracked. <code>npm run dev</code> isn't, so your own local visits don't
				count.
			</li>
		</ol>
	</section>

	<section aria-labelledby="agent">
		<h2 id="agent">Ask your agent</h2>
		<p>Connect the MCP server once (it signs in with OAuth, no key to paste):</p>
		<pre><code>claude mcp add --scope user --transport http measuremysite https://a.measuremy.site/mcp</code></pre>
		<p>Then ask things like <q>Where did yesterday's visitors come from?</q> or <q>What caused last week's spike?</q></p>
	</section>

	<section aria-labelledby="events">
		<h2 id="events">Track a conversion</h2>
		<p>
			Add <code>data-measuremysite-event</code> to any button, link or form. No JavaScript needed. This button sends a
			<code>starter_demo_click</code> event:
		</p>
		<p>
			<button type="button" class="button" data-measuremysite-event="starter_demo_click" id="demo-event">Send a test event</button>
			<span class="sent" id="demo-sent" role="status"></span>
		</p>
	</section>

	<footer>
		<a href="https://github.com/developeron29/astro-measuremysite-starter">Source on GitHub</a>
		<a href="https://measuremy.site/docs/install">measuremy.site docs</a>
		<a href="https://docs.astro.build">Astro docs</a>
	</footer>
</main>

<script>
	// The integration adds the tracker tag from an inline script in <head>, so it exists before this runs.
	const tracking = document.querySelector('script[src$="/t.js"][data-key]');
	if (tracking) {
		document.getElementById('status')?.setAttribute('data-on', '');
		const text = document.getElementById('status-text');
		if (text) text.textContent = 'Analytics is on for this site';
	}
	const button = document.getElementById('demo-event');
	const sent = document.getElementById('demo-sent');
	button?.addEventListener('click', () => {
		if (sent) sent.textContent = (window as any).measuremysite ? 'Sent.' : 'The tracker is off on this build, so nothing was sent.';
	});
</script>

<style>
	:global(:root) {
		color-scheme: light dark;
		--bg: #ffffff;
		--ink: #16161d;
		--muted: #5b5b6b;
		--line: #e4e4ec;
		--soft: #f5f4fb;
		--accent: #5b4ae8;
		--good: #1a7f4b;
		--warn: #9a5b00;
	}
	:global(body) {
		background: var(--bg);
	}
	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 4rem 1rem 3rem;
		color: var(--ink);
		font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		line-height: 1.6;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root) {
			--bg: #111117;
			--ink: #ececf2;
			--muted: #a3a3b5;
			--line: #2c2c38;
			--soft: #1c1c26;
			--accent: #a99bff;
			--good: #5fd39a;
			--warn: #f0b45a;
		}
	}
	.eyebrow {
		margin: 0;
		color: var(--accent);
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0.25rem 0 1rem;
		font-size: clamp(2rem, 5vw, 2.75rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}
	.lede {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-size: 1.125rem;
	}
	section {
		margin-top: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}
	a {
		color: var(--accent);
		text-underline-offset: 0.15em;
	}
	code {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.9em;
		background: var(--soft);
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}
	pre {
		margin: 0 0 1rem;
		padding: 0.875rem 1rem;
		background: var(--soft);
		border: 1px solid var(--line);
		border-radius: 8px;
		overflow-x: auto;
	}
	pre code {
		padding: 0;
		background: none;
		white-space: pre;
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1.25rem;
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.875rem;
		color: var(--warn);
	}
	.status[data-on] {
		color: var(--good);
	}
	.dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: currentColor;
	}
	.steps {
		margin: 0;
		padding-left: 1.25rem;
		display: grid;
		gap: 0.75rem;
	}
	.button {
		display: inline-block;
		padding: 0.625rem 1rem;
		border: 0;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
	}
	@media (prefers-color-scheme: dark) {
		.button {
			color: #16161d;
		}
	}
	.button:hover {
		filter: brightness(1.08);
	}
	.button:focus-visible,
	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.sent {
		margin-left: 0.75rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.875rem;
	}
</style>
